@@ -0,0 +1,353 @@
+import { RUNTIME_RECOVERY_BATCH_SIZE } from "@neta-art/cohub";
+import { executeTurn } from "./native/execution.js";
+import { ContextRequiredError } from "./native/results.js";
+import { ProcessCleanupUncertainError } from "./process-group.js";
+import { describeError } from "../network-error.js";
+import { serializeDiagnosticError } from "./diagnostics.js";
+
+const identity = (value) => JSON.stringify([value.sessionId, value.turnId, value.harness]);
+const pendingIdentity = ({ sessionId, turnId, harness }) => ({ sessionId, turnId, harness });
+const remember = (map, key, value) => {
+    map.set(key, value);
+    if (map.size > 4096)
+        map.delete(map.keys().next().value);
+};
+
+// Execution and receipt ownership outlive any one control socket. A binding is
+// only a delivery subscription; recovery observers never own cancellation.
+export class RuntimeExecutions {
+    active = new Map();
+    seen = new Map();
+    settled = new Map();
+    tasks = new Set();
+    channel = null;
+    closing = false;
+    constructor(options) {
+        this.options = options;
+    }
+    context(entry, channel = this.channel) {
+        return { connectionId: channel?.connectionId ?? null, sessionId: entry.input.sessionId,
+            turnId: entry.input.turnId, harness: entry.input.harness,
+            requestId: entry.input.traceContext?.requestId ?? entry.input.requestId ?? null,
+            traceContext: entry.input.traceContext };
+    }
+    log(level, event, data, entry, channel) {
+        this.options.diagnostics?.log(level, event, data, entry ? this.context(entry, channel) : { connectionId: channel?.connectionId ?? null });
+    }
+    track(task) {
+        this.tasks.add(task);
+        void task.then(() => this.tasks.delete(task), () => this.tasks.delete(task));
+        return task;
+    }
+    abort() {
+        for (const entry of this.active.values())
+            entry.controller.abort();
+    }
+    async settle() {
+        await Promise.allSettled([...this.tasks]);
+    }
+    async close() {
+        this.closing = true;
+        this.abort();
+        await this.settle();
+    }
+    attach(channel) {
+        this.channel = channel;
+        channel.requests = new Map();
+    }
+    detach(channel) {
+        if (this.channel === channel)
+            this.channel = null;
+        for (const entry of this.active.values()) {
+            for (const [requestId, binding] of entry.bindings) {
+                if (binding.channel === channel)
+                    entry.bindings.delete(requestId);
+            }
+        }
+    }
+    remove(entry) {
+        const key = identity(entry.input);
+        if (this.active.get(key) === entry)
+            this.active.delete(key);
+        for (const binding of entry.bindings.values()) {
+            if (binding.channel.requests.get(binding.requestId) === entry)
+                binding.channel.requests.delete(binding.requestId);
+        }
+        entry.bindings.clear();
+    }
